# Data files — ignore everything *inside* data/ except the small
# manifest (and README) used for reproducibility. Note: we cannot use
# `data/` as the pattern because git refuses to re-include files
# whose parent directory is excluded.
data/**
!data/
!data/MANIFEST.json
!data/README.md
# Catalogue broker : de la métadonnée de symboles (~50 Ko), pas des séries de
# marché. Versionné parce que c'est la seule trace de ce que le courtier cotait
# à une date donnée — sans elle, chaque cycle redécouvre par backtest ce qu'un
# champ de symbole dit gratuitement.
!data/broker/
!data/broker/*.csv
*.parquet
*.ods

# Results (generated) — sauf les deux JSON de reference du rapport client.
# Les tables reports/latex_report/tables/*.tex sont versionnees ; versionner la
# sortie sans l'entree rend le document publie irreproductible, et laisse
# test_published_stress_json_matches_the_current_config inoperant (il sautait
# faute de fichier, donc par defaut sur tout clone frais).
results/*
!results/production_report/
results/production_report/*
!results/production_report/*.json

# Sorties de recherche nichees (src/strategies/results/...). L'ancien motif
# `results/` les couvrait par effet de bord ; le motif ancre ci-dessus ne le
# fait plus. `*/**/` exige au moins un composant de chemin, donc ne peut pas
# matcher le results/ de la racine et casser la negation ci-dessus.
*/**/results/

# Documentation (binary)
docs/*.pdf

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp

# Secrets / local env (NEVER commit)
.env
.env.*
!.env.example
fred_api_key.txt
*.key
*.pem
