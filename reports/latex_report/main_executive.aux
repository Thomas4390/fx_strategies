\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \xpg@aux {}{french}\ignorespaces Résultats du portefeuille de production dans le testeur MetaTrader~5 sur EURUSD.c, 2021-01-01 à 2026-04-29. Ce sont les chiffres qui font foi~: ils proviennent du moteur qui exécute réellement les ordres, avec le \emph  {spread} du courtier, l'arrondi des lots et les frais de portage.}}{2}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:mt5_reference}{{1}{2}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Résultats du portefeuille de production dans le testeur MetaTrader~5 sur EURUSD.c, 2021-01-01 à 2026-04-29. Ce sont les chiffres qui font foi~: ils proviennent du moteur qui exécute réellement les ordres, avec le \emph {spread} du courtier, l'arrondi des lots et les frais de portage}{table.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \xpg@aux {}{french}\ignorespaces Décomposition du résultat par sleeve. « Gold Momentum » en concentre 86.5\,\% pour 93~transactions~: le résultat du portefeuille dépend d'un petit nombre de positions, ce qu'aucune moyenne ne montre.}}{2}{table.caption.2}\protected@file@percent }
\newlabel{tab:mt5_by_sleeve}{{2}{2}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Décomposition du résultat par sleeve. « Gold Momentum » en concentre 86.5\,\% pour 93~transactions~: le résultat du portefeuille dépend d'un petit nombre de positions, ce qu'aucune moyenne ne montre}{table.caption.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Quatre conclusions pour la décision.}{3}{paragraph*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Couche d'overlay.}{3}{paragraph*.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \xpg@aux {}{french}\ignorespaces Courbes d'équité cumulative, base 100 au 1\textsuperscript  {er}~avril 2019, échelle logarithmique. Les trois courbes fines représentent les moteurs individuels \emph  {sans pondération ni ciblage de volatilité}~; la courbe épaisse bordeaux est le portefeuille combiné après application des poids $67/9/9/15$ \emph  {et} de la couche de ciblage de volatilité (cible $\sigma ^\star = 37\,\%$, plafond $31\times $). La différence de niveau reflète l'amplification par le levier, pas une supériorité intrinsèque du combiné.}}{4}{figure.caption.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \xpg@aux {}{french}\ignorespaces Sharpe walk-forward par année sur la fenêtre glissante. 6 années sur 7 sont positives~; année(s) négative(s)~: 2023.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:walkforward_yearly}{{3}{5}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Sharpe walk-forward par année sur la fenêtre glissante. 6 années sur 7 sont positives~; année(s) négative(s)~: 2023}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \xpg@aux {}{french}\ignorespaces Zoom sur la fenêtre hors échantillon, rebasée à 100 au début de la fenêtre. Le repli maximal y atteint $-17.84\,\%$ contre $-55.00\,\%$ en in-sample.}}{5}{figure.caption.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \xpg@aux {}{french}\ignorespaces Résultats du \emph  {block bootstrap} stationnaire sur la période in-sample : moyenne et percentiles P5/P50/P95 de chaque métrique. La ligne « Cible atteinte » donne la fraction des tirages dont le CAGR tombe dans la bande visée.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:bootstrap_percentiles}{{4}{6}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Résultats du \emph {block bootstrap} stationnaire sur la période in-sample : moyenne et percentiles P5/P50/P95 de chaque métrique. La ligne « Cible atteinte » donne la fraction des tirages dont le CAGR tombe dans la bande visée}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \xpg@aux {}{french}\ignorespaces Verdict consolidé sur les tests de robustesse statistique~: 4 test(s) sur 6 franchissent leur seuil. La dernière ligne est reportée sans verdict~: le plafond de drawdown ayant été retiré de la configuration de production, elle ne répond plus à une contrainte.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:robustness_verdict_summary}{{5}{6}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Verdict consolidé sur les tests de robustesse statistique~: 4 test(s) sur 6 franchissent leur seuil. La dernière ligne est reportée sans verdict~: le plafond de drawdown ayant été retiré de la configuration de production, elle ne répond plus à une contrainte}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \xpg@aux {}{french}\ignorespaces Intervalles de confiance bootstrap à 95\,\% sur les cinq métriques principales. Les diamants orange marquent les valeurs observées, les barres bleues représentent les intervalles de confiance. La borne basse du Sharpe est strictement positive, ce qui est la condition statistique minimale de présence d'un \emph  {edge}.}}{7}{figure.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \xpg@aux {}{french}\ignorespaces \emph  {Fan chart} bootstrap --- 300~trajectoires alternatives compressées en bandes de percentiles (P5/P25/P50/P75/P95). La courbe observée (bourgogne) reste dans la partie supérieure du fan, et \emph  {sort du fan P25--P75 vers le haut} sur la fenêtre OOS~: le Sharpe observé dépasse la médiane bootstrap.}}{8}{figure.caption.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \xpg@aux {}{french}\ignorespaces Distribution des logits de validation croisée combinatoire. La ligne orange marque le seuil au-dessus duquel le vainqueur in-sample reste au-dessus de la médiane out-of-sample. La probabilité de sur-ajustement vaut $0.754$~: dans trois découpages temporels sur quatre, le vainqueur in-sample retombe sous la médiane. C'est au-dessus du seuil de danger de $0.5$, et le test échoue.}}{8}{figure.caption.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \xpg@aux {}{french}\ignorespaces Sharpe, Sortino et Calmar glissants sur fenêtre 252~jours. Les trois courbes restent majoritairement positives sur la période, avec un creux cohérent avec la seule fenêtre walk-forward négative.}}{9}{figure.caption.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Six avertissements à retenir.}{9}{paragraph*.14}\protected@file@percent }
