\newlabel{sec:gold_sizing}{{7.4}{16}{Dimensionnement progressif~: ce qui a été testé, et pourquoi il est écarté}{subsection.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \xpg@aux {}{french}\ignorespaces \textbf  {Martingale ×2 appliquée aux $47$~transactions réelles du moteur or.} En haut, la taille exigée sur tout l'historique~: elle repart à $1\times $ après chaque gain et double à chaque perte. En bas, le détail de la plus longue série de pertes réellement observée~--- sept pertes consécutives, à l'issue desquelles la règle réclame $2^{7} = 128$~fois la mise initiale pour une huitième position. Le trait orange indique où le plafond de sécurité de $4\times $ coupe l'escalade~: à partir de la troisième perte, la martingale ne fait plus ce qu'elle promet.}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:gold_martingale}{{6}{18}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces \textbf {Martingale ×2 appliquée aux $47$~transactions réelles du moteur or.} En haut, la taille exigée sur tout l'historique~: elle repart à $1\times $ après chaque gain et double à chaque perte. En bas, le détail de la plus longue série de pertes réellement observée~--- sept pertes consécutives, à l'issue desquelles la règle réclame $2^{7} = 128$~fois la mise initiale pour une huitième position. Le trait orange indique où le plafond de sécurité de $4\times $ coupe l'escalade~: à partir de la troisième perte, la martingale ne fait plus ce qu'elle promet}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \xpg@aux {}{french}\ignorespaces \textbf  {Grille $k = 0{,}5$ appliquée aux mêmes positions.} En haut, l'exposition maximale atteinte position par position~: la grille ajoute au moins un palier sur $20$~des $47$~positions et sature son plafond de $4\times $ sur sept d'entre elles. En bas, la mécanique sur une position réelle de $84$~séances~: trois paliers se déclenchent en deux jours lorsque le cours passe sous les seuils dérivés de l'ATR, l'exposition passe de $1\times $ à $4\times $, et le prix de revient moyen descend de \$$1\,974$ à \$$1\,953$. Ici le cours est ensuite remonté~--- c'est le cas favorable, celui qui rend la règle séduisante.}}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:gold_grid}{{7}{19}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces \textbf {Grille $k = 0{,}5$ appliquée aux mêmes positions.} En haut, l'exposition maximale atteinte position par position~: la grille ajoute au moins un palier sur $20$~des $47$~positions et sature son plafond de $4\times $ sur sept d'entre elles. En bas, la mécanique sur une position réelle de $84$~séances~: trois paliers se déclenchent en deux jours lorsque le cours passe sous les seuils dérivés de l'ATR, l'exposition passe de $1\times $ à $4\times $, et le prix de revient moyen descend de \$$1\,974$ à \$$1\,953$. Ici le cours est ensuite remonté~--- c'est le cas favorable, celui qui rend la règle séduisante}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \xpg@aux {}{french}\ignorespaces \textbf  {Le même signal passé dans les quatre règles, à volatilité réalisée identique.} À gauche la fenêtre de sélection, à droite la fenêtre aveugle. L'anti-martingale (vert) domine la première et se retrouve dernière sur la seconde~; la martingale (rouge) fait exactement l'inverse. Le dimensionnement plat (bleu marine) reste au milieu dans les deux cas. C'est cette instabilité, et non le niveau atteint par l'une ou l'autre, qui a décidé du choix retenu.}}{21}{figure.caption.15}\protected@file@percent }
\newlabel{fig:gold_outcome}{{8}{21}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces \textbf {Le même signal passé dans les quatre règles, à volatilité réalisée identique.} À gauche la fenêtre de sélection, à droite la fenêtre aveugle. L'anti-martingale (vert) domine la première et se retrouve dernière sur la seconde~; la martingale (rouge) fait exactement l'inverse. Le dimensionnement plat (bleu marine) reste au milieu dans les deux cas. C'est cette instabilité, et non le niveau atteint par l'une ou l'autre, qui a décidé du choix retenu}{figure.caption.15}{}}
