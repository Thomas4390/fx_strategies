\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \xpg@aux {}{french}\ignorespaces Carte de chaleur ternaire du Sharpe WF sur le 2-simplexe complet ($231$~points). Les sommets correspondent aux allocations pures $100\,\%$~MR, $100\,\%$~TS et $100\,\%$~RSI. Les sommets correspondent aux répartitions pures du trio. La zone la plus défavorable est le coin $100\,\%$~RSI~; le plateau haut forme une bande large, ce qui est le résultat recherché.}}{54}{figure.caption.47}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces \xpg@aux {}{french}\ignorespaces Top-3 et bottom-3 des 231 répartitions du simplex FX (pas de 0.05), classées par Sharpe WF, la sleeve or restant à 10\,\%. La part moyenne de MR y passe de 45\,\% en tête à 2\,\% en queue de classement.}}{54}{table.caption.48}\protected@file@percent }
\newlabel{tbl:weight_sensitivity_extremes}{{21}{54}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Top-3 et bottom-3 des 231 répartitions du simplex FX (pas de 0.05), classées par Sharpe WF, la sleeve or restant à 10\,\%. La part moyenne de MR y passe de 45\,\% en tête à 2\,\% en queue de classement}{table.caption.48}{}}
