\newlabel{tbl:weight_sensitivity_extremes}{{21}{58}{\texorpdfstring {\xpg@aux {\xpg@current@opts }{\languagename }}{}\ignorespaces Top-3 et bottom-3 des 231 répartitions du simplex FX (pas de 0.05), classées par Sharpe WF, la sleeve or restant à 10\,\%. La part moyenne de MR y passe de 45\,\% en tête à 2\,\% en queue de classement}{table.caption.51}{}}
