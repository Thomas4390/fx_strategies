\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \xpg@aux {}{french}\ignorespaces Breakout Short, même règle de choix. La cible est le barreau inférieur~; le stop est au-dessus du niveau franchi.}}{17}{figure.caption.14}\protected@file@percent }
